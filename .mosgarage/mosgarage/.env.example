# ============================================================
# mosgarage platform — environment variables
# cp .env.example .env  then edit before running
# ============================================================

# ── Access URLs ────────────────────────────────────────────────────
# Public URL of the control plane
MOSGARAGE_ACCESS_URL=http://localhost:7070
MOSGARAGE_DOMAIN=mosgarage.localhost

# Wildcard domain for workspace tunnels (e.g. *.try.mosgarage.app)
# Leave blank for local-only mode
MOSGARAGE_WILDCARD_URL=

# ── Secret key (REQUIRED — generate with: openssl rand -hex 32) ───
MOSGARAGE_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# ── Admin credentials ──────────────────────────────────────────────
MOSGARAGE_ADMIN_EMAIL=admin@mosgarage.local
MOSGARAGE_ADMIN_PASSWORD=changeme

# ── Database ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=mosgarage

# ── Provisioner ────────────────────────────────────────────────────
MOSGARAGE_PROVISIONER=docker        # docker | kubernetes
MOSGARAGE_WORKSPACE_IMAGE=docker.io/mosgarage/workspace:latest

# ── GitHub sync (workspace backup) ────────────────────────────────
GITHUB_USER=mosgaragedev
GITHUB_ORG=mosgarage
GITHUB_REPO=mosgaragedev
GIT_BRANCH=main
GIT_NAME=mosgaragedev
GIT_EMAIL=mosgaragedev@users.noreply.github.com
GITHUB_TOKEN=                       # ghp_... or leave blank for SSH key
GIT_SYNC_INTERVAL=900               # seconds between auto-pushes

# ── Traefik ────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO

# ── Runtime ────────────────────────────────────────────────────────
MOSGARAGE_PORT=7070
MOSGARAGE_AGENT_PORT=7071
MOSGARAGE_ENV=production
MOSGARAGE_TELEMETRY=false

# ── SSH server ─────────────────────────────────────────────────────
# Paste content of ~/.ssh/id_ed25519.pub  (OR leave blank = fetched from GitHub)
MOSGARAGE_SSH_PUBLIC_KEY=
MOSGARAGE_SSH_PUBLIC_KEYS_B64=
MOSGARAGE_SSH_GENERATE_CLIENT_KEY=false
MOSGARAGE_SSH_ALLOW_PASSWORD=false
MOSGARAGE_SSH_PORT=2222

# ── Microsoft Entra ID ─────────────────────────────────────────────
# Run: ./deploy/entra-setup.sh   (bash / macOS / Linux / WSL)
#   or: ./deploy/entra-setup.ps1  (PowerShell / Windows)
# Permissions: User.Read | Group.Read.All | Tasks.ReadWrite
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUDIENCE=
