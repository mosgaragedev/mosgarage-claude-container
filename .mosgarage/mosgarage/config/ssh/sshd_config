# ============================================================
# mosgarage · sshd_config
# Cross-platform SSH server — works with:
#   macOS Terminal / iTerm2, Windows Terminal, PuTTY,
#   VS Code Remote-SSH, JetBrains Gateway, Linux ssh
# Port: 2222 (workspace) / 2200 (control plane)
# ============================================================

# ── Network ───────────────────────────────────────────────────────
Port 2222
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

# ── Host keys (auto-generated by ssh-setup.sh on first boot) ─────
HostKey /etc/ssh/host_keys/ssh_host_ed25519_key
HostKey /etc/ssh/host_keys/ssh_host_rsa_key
HostKey /etc/ssh/host_keys/ssh_host_ecdsa_key

# Prefer modern algorithms — broad client compatibility
HostKeyAlgorithms ssh-ed25519,ecdsa-sha2-nistp256,rsa-sha2-512,rsa-sha2-256

# ── Auth ──────────────────────────────────────────────────────────
# Key-based auth only in production (set MOSGARAGE_SSH_ALLOW_PASSWORD=true for dev)
PubkeyAuthentication yes
AuthorizedKeysFile  /etc/ssh/authorized_keys/%u .ssh/authorized_keys

# Password auth: disabled by default, enable via env var in ssh-setup.sh
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no

# PAM: keep enabled for account/session management
UsePAM yes

# Root login: never
PermitRootLogin no

# ── Session features (important for VS Code Remote-SSH) ───────────
# Allow TCP forwarding (port tunnelling from client)
AllowTcpForwarding yes
# Allow X11 (optional, for GUI apps)
X11Forwarding yes
X11DisplayOffset 10
# Allow agent forwarding (so git auth works inside SSH session)
AllowAgentForwarding yes
# Allow stream local forwarding (Unix socket forwarding)
AllowStreamLocalForwarding yes
# Accept locale from client (prevents locale errors on macOS)
AcceptEnv LANG LC_* TERM COLORTERM
# Enable SFTP subsystem (VS Code file sync, SCP, WinSCP)
Subsystem sftp /usr/lib/openssh/sftp-server

# ── Performance & stability ───────────────────────────────────────
ClientAliveInterval 60
ClientAliveCountMax 10
TCPKeepAlive yes
Compression yes
UseDNS no                      # faster connections (no reverse DNS lookup)
MaxSessions 50
MaxStartups 20:30:100

# ── Ciphers (broad compatibility: modern + legacy clients) ─────────
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,diffie-hellman-group-exchange-sha256

# ── Logging ──────────────────────────────────────────────────────
SyslogFacility AUTH
LogLevel INFO

# ── Banner (shown to connecting clients) ─────────────────────────
Banner /etc/ssh/mosgarage-banner.txt

# ── Allowed users ─────────────────────────────────────────────────
AllowUsers mosgarage
